@startuml EntityRelationshipDiagram

title Punchclock - Entity Relationship Diagram

class ApplicationUser {
    + id : Long
    --
    - username : String
    - passwordHash : String
    - role : String
}

class Entry {
    + id : Long
    --
    - checkIn : LocalDateTime
    - checkOut : LocalDateTime
    - userId : Long
    - categoryId : Long
}

class Category {
    + id : Long
    --
    - title : String
}

class Tag {
    + id : Long
    --
    - title : String
}

class EntryTag {
    + entryId : Long
    + tagId : Long
}

ApplicationUser "1" -- "0..*" Entry : owns
Category "1" -- "0..*" Entry : categorizes
Entry "1" -- "0..*" EntryTag
Tag "1" -- "0..*" EntryTag

@enduml